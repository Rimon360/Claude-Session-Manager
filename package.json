{
  "name": "claude-code-recovery",
  "productName": "Claude Code Recovery",
  "version": "0.1.1",
  "description": "Discover, back up, export, import, merge and sync local Claude Code session files. Reads raw transcripts on disk; never trusts a tool's own index.",
  "main": "src/main/main.js",
  "author": {
    "name": "Rimon Labs LLC",
    "url": "https://rimonlabs.com"
  },
  "homepage": "https://claudecoderecovery.rimonlabs.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rimon360/Claude-Session-Manager.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/F2I226JXBS"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "test:large": "node --expose-gc test/run.js large",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "dev.rimonlabs.claudesessionmanager",
    "copyright": "Copyright © 2026 Rimon Labs LLC",
    "productName": "Claude Code Recovery",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Rimon360",
        "repo": "Claude-Session-Manager",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!test/**",
      "!shots/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
